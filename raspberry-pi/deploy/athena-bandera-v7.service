[Unit]
Description=Athena Rover - aviso de camara para v8-logica-completa (solo detecta bandera y avisa al ESP32)
After=multi-user.target
# Sin límite de reintentos: si la cámara o el ESP32 tardan en enumerarse por
# USB al encender, el servicio se reinicia solo hasta que estén listos, en
# vez de darse por vencido después de unos pocos intentos.
StartLimitIntervalSec=0

[Service]
Type=simple

# OBLIGATORIO: reemplaza esto con tu usuario real de Linux en la Pi (correlo
# tú misma con `whoami` para saber cuál es) y la ruta real del repo.
User=TU_USUARIO_AQUI
WorkingDirectory=/home/TU_USUARIO_AQUI/Athena-Rover-2026/raspberry-pi
EnvironmentFile=/home/TU_USUARIO_AQUI/Athena-Rover-2026/raspberry-pi/deploy/equipo-bandera.env

# Le da unos segundos a la cámara USB y al ESP32 para enumerarse antes del
# primer intento. Si de todas formas no están listos, avisar_bandera_v8.py
# falla y Restart=on-failure lo vuelve a intentar solo.
ExecStartPre=/bin/sleep 5

# NORMAL: EQUIPO sin definir en equipo-bandera.env -- avisar_bandera_v8.py
# espera el byte 'R'/'A' que manda v8-logica-completa después de leer
# el switch físico de equipo del chasis, así que nunca se puede desincronizar
# de él. ${EQUIPO:+--equipo $EQUIPO} se expande a nada si EQUIPO no está
# definida, o a "--equipo rojo"/"--equipo azul" si se descomentó en
# equipo-bandera.env (banco sin switch instalado o sin ESP32 conectado).
ExecStart=/bin/sh -c 'exec /usr/bin/python3 scripts/avisar_bandera_v8.py ${EQUIPO:+--equipo $EQUIPO}'

Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
