# Recortes generados a partir de data/raw/ — se pueden regenerar, no se versionan.
data/crops/
# Modelos entrenados: pesan y se regeneran con scripts/train_classifier.py
models/*.tflite
models/*.h5
models/*.keras
# Modelo de banderas exportado de Edge Impulse (target Linux AARCH64): pesa
# ~13 MB y se regenera reentrenando en Edge Impulse Studio y exportando de
# nuevo, no hace falta versionarlo.
models/*.eim
# Estado del despliegue (qué equipo corre en ESTA Pi ahora, y en qué puerto
# serial está conectado ESTE ESP32), no del código.
deploy/equipo.env
config/rover.json
__pycache__/
*.py[cod]
.venv/
venv/
